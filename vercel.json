{
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30,
      "includeFiles": [
        "apps/api/dist/**",
        "apps/api/package.json"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "installCommand": "npm ci --include=dev"
}
